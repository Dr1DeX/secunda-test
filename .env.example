# Пример конфигурации + для локальной развертки приложения, НЕ ДЛЯ ПРОДА!

ENV=local

# # FastAPI
MICROSERVICE_NAME=secunda
APP_HOST=api
APP_PORT=8889

# Databases
# # Postgresql
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_SIZE=30
DATABASE_ECHO=True

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=betronic
DB_DRIVER=postgresql+asyncpg
DB_HOST=db
DB_PORT=5432

# # Redis
REDIS_DRIVER=redis
REDIS_USER=default
REDIS_PASSWORD=redis12345
REDIS_HOST=redis
REDIS_PORT=6390